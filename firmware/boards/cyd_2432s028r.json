{
  "build": {
    "arduino": {
      "ldscript": "esp32_out.ld"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32_DEV",
      "-DARDUINO_USB_CDC_ON_BOOT=0"
    ],
    "f_cpu": "240000000L",
    "f_flash": "40000000L",
    "flash_mode": "dio",
    "mcu": "esp32",
    "variant": "esp32",
    "partitions": "partitions.csv"
  },
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "debug": {
    "cdebug": [
      "-Og",
      "-g3",
      "-ggdb"
    ],
    "default_tool": "esp-prog",
    "onboard_tools": [
      "esp-prog"
    ],
    "openocd_target": "esp32.cfg"
  },
  "frameworks": [
    "arduino"
  ],
  "name": "CYD ESP32-2432S028R (Cheap Yellow Display)",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 327680,
    "maximum_size": 3145728,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "https://github.com/witnessmenow/ESP32-Cheap-Yellow-Display",
  "vendor": "Sunton"
}
