# ---- Protocol codegen ----
# Generated sources ARE committed: tools/gen_proto.py --check fails CI when they
# drift from protocol/dashcue.proto, which is only meaningful if they are in the
# tree. Android sources are generated during the Gradle build (see that tool's
# docstring) and do not belong in version control.
android/core/protocol/src/main/java/com/dashcue/v1/

# ---- Editor / OS / host app ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Freebuff's own session metadata - not part of the project (section 5.5 of the
# spec requires an isolated repository with nothing extra in the release tree).
.freebuff/
.agents/
*_PROMPT.md
*HANDOFF*.md
TEST_READY.md
build_errors.txt
*.log

